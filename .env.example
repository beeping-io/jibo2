# ────────────────────────────────────────────────────────────────────
# 🤖 Jibo2 — developer environment template
#
# Copy to `.env` and fill in the keys you need. `.env` is gitignored;
# `.env.example` is committed. Placeholders are safe to commit.
#
# You only need the blocks for the subsystems you are actively working
# on — unfilled keys are harmless until their feature lands.
# ────────────────────────────────────────────────────────────────────

# ─── 🤖 Jibo2 runtime (already consumed by src/jibo2/log.py) ─────────
# dev = human-readable console logs; prod = JSON logs.
JIBO2_ENV=dev
# DEBUG | INFO | WARNING | ERROR | CRITICAL.
JIBO2_LOG_LEVEL=INFO
# Optional. If set, also persist logs to {dir}/jibo2.log with rotation.
# JIBO2_LOG_DIR=./logs


# ─── 🔥 Firebase (activated in F0:M5, J2-18 → J2-23) ─────────────────
# Target one of: jibo2-dev, jibo2-staging, jibo2-prod.
FIREBASE_PROJECT_ID=jibo2-dev
# Path to the service account JSON. Get it from:
# Firebase console → Project settings → Service accounts → Generate key.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/jibo2-dev-firebase-admin.json


# ─── 🧠 LLM providers (activated in F4, J2-29) ──────────────────────
# Primary. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Alternates for the benchmark harness (F4:M29).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXX
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Local Llama via Ollama — default is the local default.
# OLLAMA_HOST=http://localhost:11434


# ─── 🔊 TTS providers (activated in F4, J2-28) ──────────────────────
ELEVENLABS_API_KEY=xi-xxxxxxxxxxxxxxxxxxxxxxxx
CARTESIA_API_KEY=sk_car_xxxxxxxxxxxxxxxxxxxxxxxx
# Google Cloud TTS uses GOOGLE_APPLICATION_CREDENTIALS above.


# ─── 🎤 STT providers (activated in F4, J2-27) ──────────────────────
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ASSEMBLYAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY above is reused for Whisper API.


# ─── 🐝 Beeping ecosystem (activated in F4/F10) ─────────────────────
# Ultrasonic pairing + send-to-robot.
BEEPING_API_KEY=bee_xxxxxxxxxxxxxxxxxxxxxxxx
# Voice stack candidate in the F4:M30 benchmark.
SKYWALKER_API_KEY=sky_xxxxxxxxxxxxxxxxxxxxxxxx
# Alternate multi-agent platform (F4:M36).
AI_AGENTS_API_KEY=aia_xxxxxxxxxxxxxxxxxxxxxxxx


# ─── 📱 Linear (local automation, optional) ─────────────────────────
# Use only for scripts that read/write Linear from your dev machine.
# Never ship to prod — the agent does not need this.
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxxxxxx


# ─── 🤖 Robot connection (activated in F2, J2-72 → J2-88) ───────────
JIBO2_HOST=jibo2.local
# Path to the SSH private key used to connect. Keep permissions 0600.
JIBO2_SSH_KEY=~/.ssh/jibo2_ed25519
